{
    "name": "oc-pledge-node-verify",
    "private": true,
    "version": "0.1.0",
    "description": "Verify an OC Pledge in Node with pledge-core and bip322, and resolve its state at a block height, with no service asked.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "verify": "tsx src/verify-cli.ts",
        "state": "tsx src/state-cli.ts",
        "build": "tsc --noEmit",
        "test": "tsx --test test/*.test.ts"
    },
    "dependencies": {
        "@orangecheck/bip322": "^1.1.3",
        "@orangecheck/pledge-core": "^3.7.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
